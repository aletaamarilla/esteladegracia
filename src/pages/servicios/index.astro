---
import PageLayout from '@/layouts/PageLayout.astro'
import PageHero from '@/sections/PageHero.astro'
import CTABanner from '@/sections/CTABanner.astro'
import TrustBar from '@/sections/TrustBar.astro'
import ServiceIcon from '@/components/shared/ServiceIcon.astro'
import { sanityFetch } from '@/lib/sanity'
import { servicesIndexPageQuery, allServicesQuery, siteSettingsQuery, aboutPageQuery } from '@/lib/queries'
import type { ServicesIndexPage, ServicePreview, SiteSettings, AboutPage } from '@/lib/sanityTypes'
import { fullBleedHero, hotspotToObjectPosition, portraitImage, portraitSrcSet, srcSet } from '@/lib/sanityImage'
import { resolveIconSvg } from '@/lib/icons'
import { GROUP_PROGRAM, normalizeGroupProgramText } from '@/lib/groupProgram'

const [page, services, settings, aboutPage] = await Promise.all([
  sanityFetch<ServicesIndexPage>(servicesIndexPageQuery),
  sanityFetch<ServicePreview[]>(allServicesQuery),
  sanityFetch<SiteSettings>(siteSettingsQuery),
  sanityFetch<AboutPage>(aboutPageQuery),
])

const whatsappUrl = settings?.contactInfo?.whatsappNumber
  ? `https://wa.me/${settings.contactInfo.whatsappNumber}?text=${encodeURIComponent(settings.contactInfo.whatsappDefaultMessage ?? 'Hola! Me gustaria agendar una cita.')}`
  : 'https://wa.me/34600000000'

const ctaRaw = page?.ctaBanner ?? {}
const cta = {
  title: ctaRaw.title,
  highlight: ctaRaw.highlight,
  description: ctaRaw.description,
  primaryCta: ctaRaw.primaryCta,
  secondaryCta: ctaRaw.secondaryCta,
  backgroundImage: ctaRaw.backgroundImage,
}

const processSteps = page?.processSteps ?? []

const stepGradients = [
  'from-[#98465d] to-[#9591eb]',
  'from-[#9591eb] to-[#cfcdff]',
  'from-[#cfcdff] to-[#98465d]/50',
]

const approach = page?.therapeuticApproach ?? {}
const methods = approach?.methods ?? []
const quickFaq = page?.quickFaq ?? []
const methodSearchText = (method: { name?: string; fullName?: string; icon?: string }) =>
  `${method.name ?? ''} ${method.fullName ?? ''} ${method.icon ?? ''}`.toLocaleLowerCase('es')

const isTccMethod = (method: { name?: string; fullName?: string; icon?: string }) => {
  const text = methodSearchText(method)

  return text.includes('tcc') || text.includes('cognitivo-conductual')
}

const isPsicodramaMethod = (method: { name?: string; fullName?: string; icon?: string }) =>
  methodSearchText(method).includes('psicodrama')

const isMindfulnessMethod = (method: { name?: string; fullName?: string; icon?: string }) => {
  const text = methodSearchText(method)

  return text.includes('mindfulness') || text.includes('atención plena') || text.includes('atencion plena')
}

const isRegulacionMethod = (method: { name?: string; fullName?: string; icon?: string }) => {
  const text = methodSearchText(method)

  return (
    text.includes('regulación') ||
    text.includes('regulacion') ||
    text.includes('comprender y manejar') ||
    text.includes('manejar lo que sientes')
  )
}

const customMethodIconSrc = (method: { name?: string; fullName?: string; icon?: string }) => {
  if (isTccMethod(method)) return '/icon-tcc.png'
  if (isPsicodramaMethod(method)) return '/icon-psicodrama.png'
  if (isMindfulnessMethod(method)) return '/icon-mindfulness.png'
  if (isRegulacionMethod(method)) return '/icon-regulacion.png'
  return null
}

const individual = services?.find(s => s.color === 'rose')
const group = services?.find(s => s.color === 'purple')
const groupProgramTagline = `${GROUP_PROGRAM.name}. ${GROUP_PROGRAM.description}`
const normalizedQuickFaq = quickFaq.map((item) => ({
  ...item,
  question: normalizeGroupProgramText(item.question) ?? item.question,
  answer: normalizeGroupProgramText(item.answer) ?? item.answer,
}))
---

<PageLayout
  title="Servicios"
  description="Terapia individual y grupal online. Encuentra el camino que se adapta a ti."
>
  <PageHero
    label={page?.heroLabel}
    title={page?.heroTitle}
    highlight={page?.heroHighlight}
    highlightColor="purple"
    description={page?.heroDescription}
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios' },
    ]}
    backgroundImageUrl={page?.heroImage ? fullBleedHero(page.heroImage) : undefined}
    backgroundImageSrcSet={page?.heroImage ? srcSet(page.heroImage) : undefined}
    backgroundImagePosition={hotspotToObjectPosition(page?.heroImage)}
  />

  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f4eced">
    <section class="py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-72 h-72 bg-[#cfcdff]/15 rounded-full blur-3xl"></div>
      <div class="container mx-auto px-5 relative">
        <div class="text-center mb-10 md:mb-14">
          <span class="inline-block text-[#9591eb] font-medium mb-4 tracking-wide uppercase text-sm">Tu proceso</span>
          <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
            Empezar es mas facil de lo que{' '}
            <span class="text-[#98465d]">piensas</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          {processSteps.map((item, i) => (
            <div class="group text-center hover-glow rounded-3xl p-5 md:p-8 cursor-default">
              <div class={`w-16 h-16 bg-gradient-to-br ${stepGradients[i % stepGradients.length]} rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={resolveIconSvg(item.icon)} />
              </div>
              <span class="text-xs font-bold text-[#9591eb] tracking-widest uppercase">{item.step}</span>
              <h3 class="font-display text-xl text-[#5d5a5a] mt-2 mb-3">{item.title}</h3>
              <p class="text-sm text-[#5d5a5a]/70 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block max-w-3xl mx-auto mt-[-7rem] mb-8 relative z-0">
          <div class="h-px bg-gradient-to-r from-[#98465d]/20 via-[#9591eb]/30 to-[#cfcdff]/20 mx-24"></div>
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f4eced; --next-bg: #efedf6">
    <section class="py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-80 h-80 bg-[#98465d]/5 rounded-full blur-3xl"></div>
      <div class="container mx-auto px-5 relative">
        <div class="text-center mb-10 md:mb-14">
          <span class="inline-block text-[#98465d] font-medium mb-4 tracking-wide uppercase text-sm">
            {page?.comparisonSection?.sectionLabel}
          </span>
          <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
            {page?.comparisonSection?.title}{' '}
            <span class="text-[#9591eb]">{page?.comparisonSection?.titleHighlight}</span>
          </h2>
          <p class="text-[#5d5a5a]/70 mt-4 max-w-xl mx-auto">
            {page?.comparisonSection?.subtitle}
          </p>
        </div>

        <div class="mx-auto grid max-w-md gap-5 md:max-w-5xl md:grid-cols-2 md:gap-8">
          {individual && (
            <a href={`/servicios/${individual.slug.current}`} class="group">
              <div class="relative bg-white rounded-[2rem] overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col h-full">
                <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#98465d] to-[#9591eb]"></div>
                <div class="p-5 md:p-10 flex-1 flex flex-col">
                  <div class="flex items-center justify-between mb-6">
                    <div class="w-14 h-14 md:w-16 md:h-16 bg-[#98465d]/10 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:bg-[#98465d]/15 transition-all duration-300">
                      <ServiceIcon type="individual" />
                    </div>
                    {individual.previewCard?.badge && (
                      <span class="inline-flex items-center rounded-full bg-[#cfcdff] text-[#5d5a5a] px-4 py-1.5 text-xs font-medium">{individual.previewCard.badge}</span>
                    )}
                  </div>
                  <h3 class="font-display text-2xl text-[#5d5a5a] mb-2">{individual.title}</h3>
                  {individual.previewCard?.shortDescription && <p class="text-[#5d5a5a]/60 mb-6 text-sm leading-relaxed">{individual.previewCard.shortDescription}</p>}
                  {individual.previewCard?.features && individual.previewCard.features.length > 0 && (
                    <div class="space-y-3 mb-8 flex-1">
                      {individual.previewCard.features.map((feat) => (
                        <div class="flex items-center gap-3">
                          <div class="w-5 h-5 bg-[#98465d]/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#98465d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                          </div>
                          <span class="text-[#5d5a5a] text-sm">{feat}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {individual.pricing && individual.pricing.length > 0 && (
                    <div class="bg-[#f6f3f5] rounded-2xl p-5 mb-6">
                      {individual.pricing.map((p, pi) => (
                        <div class={`flex items-start justify-between gap-3 ${pi > 0 && p.savings ? 'pt-2 border-t border-[#cfcdff]/50' : pi > 0 ? 'mt-2' : ''}`}>
                          <span class={`min-w-0 flex-1 text-sm leading-snug ${p.savings ? 'font-medium text-[#5d5a5a]' : 'text-[#5d5a5a]/60'}`}>{p.name}</span>
                          <div class="shrink-0 text-right">
                            <span class={`font-bold ${p.savings ? 'text-[#9591eb] text-lg' : 'text-[#98465d]'}`}>&euro;{p.price}</span>
                            {p.savings && p.savings > 0 && <span class="block text-xs text-green-600 font-medium">Ahorra &euro;{p.savings}</span>}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                  <div class="hover-shimmer mt-auto w-full inline-flex items-center justify-center gap-2 bg-[#98465d] group-hover:bg-[#98465d]/90 text-white rounded-full py-4 text-sm font-medium transition-all hover:shadow-lg hover:shadow-[#98465d]/25 sm:text-base">
                    Ver detalles
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </div>
                </div>
              </div>
            </a>
          )}
          {group && (
            <a href={`/servicios/${group.slug.current}`} class="group">
              <div class="relative bg-white rounded-[2rem] overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col h-full">
                <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#9591eb] to-[#cfcdff]"></div>
                <div class="p-5 md:p-10 flex-1 flex flex-col">
                  <div class="flex items-center mb-6">
                    <div class="w-14 h-14 md:w-16 md:h-16 bg-[#9591eb]/10 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:bg-[#9591eb]/15 transition-all duration-300">
                      <ServiceIcon type="group" />
                    </div>
                  </div>
                  <h3 class="font-display text-2xl text-[#5d5a5a] mb-2">{GROUP_PROGRAM.eyebrow}</h3>
                  <p class="text-[#5d5a5a]/60 mb-6 text-sm leading-relaxed">{groupProgramTagline}</p>
                  {group.previewCard?.features && group.previewCard.features.length > 0 && (
                    <div class="space-y-3 mb-8 flex-1">
                      {group.previewCard.features.map((feat) => (
                        <div class="flex items-center gap-3">
                          <div class="w-5 h-5 bg-[#9591eb]/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#9591eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                          </div>
                          <span class="text-[#5d5a5a] text-sm">{feat}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {group.pricing && group.pricing.length > 0 && (
                    <div class="bg-gradient-to-br from-[#9591eb]/10 to-[#cfcdff]/20 rounded-2xl p-5 mb-6">
                      {group.pricing.map((p) => (
                        <div class="flex items-start justify-between gap-3">
                          <span class="min-w-0 flex-1 text-sm leading-snug text-[#5d5a5a]/60">{p.name}</span>
                          <div class="shrink-0 text-right">
                            <span class="font-bold text-[#9591eb] text-lg">&euro;{p.price}</span>
                            {p.savings && p.savings > 0 && <span class="block text-xs text-[#5d5a5a]/50">{p.savings} sesiones</span>}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                  <div class="hover-shimmer mt-auto w-full inline-flex items-center justify-center gap-2 bg-[#9591eb] group-hover:bg-[#9591eb]/90 text-white rounded-full py-4 text-sm font-medium transition-all hover:shadow-lg hover:shadow-[#9591eb]/25 sm:text-base">
                    Ver detalles
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </div>
                </div>
              </div>
            </a>
          )}
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #efedf6; --next-bg: #f5eff1">
    <TrustBar stats={aboutPage?.trustBar} />
  </div>

  <div class="section-flow" style="--section-bg: #f5eff1; --next-bg: #efedf6">
    <section class="py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute top-10 right-10 w-60 h-60 bg-[#9591eb]/10 rounded-full blur-3xl"></div>
      <div class="container mx-auto px-5 relative">
        <div class="text-center mb-10 md:mb-14">
          <span class="inline-block text-[#9591eb] font-medium mb-4 tracking-wide uppercase text-sm">
            {approach?.sectionLabel}
          </span>
          <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
            {approach?.title}{' '}
            <span class="text-[#98465d]">{approach?.titleHighlight}</span>
          </h2>
          <p class="text-[#5d5a5a]/70 mt-4 max-w-2xl mx-auto">
            {approach?.subtitle}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
          {methods.map((method) => {
            const customIconSrc = customMethodIconSrc(method)

            return (
              <div class="group bg-white rounded-2xl p-6 shadow-sm hover-glow cursor-default text-center">
                <div class="w-12 h-12 bg-gradient-to-br from-[#98465d]/10 to-[#9591eb]/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 group-hover:from-[#98465d]/20 group-hover:to-[#9591eb]/20 transition-all duration-300">
                  {customIconSrc ? (
                    <img
                      src={customIconSrc}
                      alt=""
                      class="h-8 w-9 md:h-9 md:w-10 max-w-none object-contain"
                      loading="lazy"
                      decoding="async"
                      aria-hidden="true"
                    />
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#98465d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={resolveIconSvg(method.icon)} />
                  )}
                </div>
                <h3 class="font-bold text-[#5d5a5a] text-sm mb-1">{method.name}</h3>
                <p class="text-xs text-[#9591eb] font-medium mb-2">{method.fullName}</p>
                <p class="text-xs text-[#5d5a5a]/60 leading-relaxed">{method.description}</p>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #efedf6; --next-bg: #f5eff2">
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-5">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-10 md:mb-12">
            <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
              Dudas{' '}
              <span class="text-[#9591eb]">frecuentes</span>
            </h2>
          </div>

          <div class="space-y-4">
            {normalizedQuickFaq.map((item) => (
              <details class="group bg-[#f6f3f5] rounded-2xl overflow-hidden hover:shadow-md transition-shadow cursor-pointer">
                <summary class="flex items-center justify-between p-6 font-medium text-[#5d5a5a] list-none">
                  {item.question}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9591eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 ml-4 group-open:rotate-180 transition-transform duration-300"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="px-6 pb-6 text-sm text-[#5d5a5a]/70 leading-relaxed -mt-2">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>

          <div class="text-center mt-8">
            <a href="/faq" class="inline-flex items-center gap-2 text-[#98465d] font-medium hover:underline underline-offset-4 transition-all">
              Ver todas las preguntas
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f5eff2; --next-bg: #f6f3f5">
    <CTABanner
      title={cta.title}
      highlight={cta.highlight}
      description={cta.description}
      primaryCta={cta.primaryCta}
      secondaryCta={cta.secondaryCta}
      backgroundImageUrl={cta.backgroundImage ? portraitImage(cta.backgroundImage) : undefined}
      backgroundImageSrcSet={cta.backgroundImage ? portraitSrcSet(cta.backgroundImage) : undefined}
      backgroundImagePosition={hotspotToObjectPosition(cta.backgroundImage)}
    />
  </div>
</PageLayout>
