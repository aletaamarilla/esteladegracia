---
import PageLayout from '@/layouts/PageLayout.astro'
import CTABanner from '@/sections/CTABanner.astro'
import TransitionImageBanner from '@/sections/TransitionImageBanner.astro'
import TrustBar from '@/sections/TrustBar.astro'
import TestimonialHighlight from '@/sections/TestimonialHighlight.astro'
import AboutHero from '@/components/islands/AboutHero'
import TimelineAnimated from '@/components/islands/TimelineAnimated'
import { sanityFetch } from '@/lib/sanity'
import { aboutPageQuery, siteSettingsQuery } from '@/lib/queries'
import type { AboutPage, SiteSettings } from '@/lib/sanityTypes'
import { portableTextToHtml } from '@/lib/portableText'
import { resolveIconSvg } from '@/lib/icons'
import { croppedImage, croppedSrcSet, fullBleedHero, hotspotToObjectPosition, portraitImage, portraitSrcSet, srcSet, videoPosterImage } from '@/lib/sanityImage'

const [page, settings] = await Promise.all([
  sanityFetch<AboutPage>(aboutPageQuery),
  sanityFetch<SiteSettings>(siteSettingsQuery),
])

const whatsappUrl = settings?.contactInfo?.whatsappNumber
  ? `https://wa.me/${settings.contactInfo.whatsappNumber}?text=${encodeURIComponent(settings.contactInfo.whatsappDefaultMessage ?? 'Hola! Me gustaria agendar una cita.')}`
  : 'https://wa.me/34600000000'

const story = page?.personalStory
const approach = page?.approach
const ctaRaw = page?.ctaBanner ?? {}
const cta = {
  title: ctaRaw.title,
  highlight: ctaRaw.highlight,
  description: ctaRaw.description,
  primaryCta: ctaRaw.primaryCta,
  secondaryCta: ctaRaw.secondaryCta,
  backgroundImage: ctaRaw.backgroundImage,
}

const storyHtml = story?.storyBody ? portableTextToHtml(story.storyBody) : ''
const storyImageAspectRatio = 3 / 4
const storyImageWidths = [640, 960, 1280, 1600]

const personalTraits = story?.personalTraits ?? []
const approachCards = approach?.cards ?? []
const pullQuotes = story?.pullQuotes ?? []
const timelineItems = page?.timeline ?? []

---

<PageLayout
  title="Sobre Mi"
  description="Conoce a la profesional y persona detras de la terapia. Mas de 12 anos de experiencia, artista, migrante y viajera."
>
  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f4eced">
    <AboutHero
      client:visible
      headline={page?.hero?.headline}
      subheadline={page?.hero?.subheadline}
      videoPlaceholderText={page?.hero?.videoPlaceholderText}
      heroImageUrl={page?.hero?.heroImage ? croppedImage(page.hero.heroImage, 1600, storyImageAspectRatio, 95) : undefined}
      heroImageSrcSet={page?.hero?.heroImage ? croppedSrcSet(page.hero.heroImage, storyImageWidths, storyImageAspectRatio, 95) : undefined}
      videoUrl={page?.hero?.videoUrl}
      videoPosterUrl={page?.hero?.videoPoster ? videoPosterImage(page.hero.videoPoster) : undefined}
    />
  </div>

  <div class="section-flow" style="--section-bg: #f4eced; --next-bg: #efedf6">
    <section class="py-14 md:py-20 lg:py-28 relative overflow-hidden">
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-[#98465d]/5 rounded-full blur-3xl"></div>

      <div class="container mx-auto px-5 relative">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-1 bg-[#98465d] rounded-full"></div>
          <span class="text-[#98465d] font-medium tracking-wide uppercase text-sm">
            {story?.sectionLabel}
          </span>
        </div>

        <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] mb-12 text-balance">
          {story?.title}{' '}
          <span class="text-[#98465d]">{story?.titleHighlight}</span>
        </h2>

        {story?.storyImage && (
          <div class="lg:hidden mb-8">
            <img
              src={croppedImage(story.storyImage, 1600, storyImageAspectRatio, 95)}
              srcset={croppedSrcSet(story.storyImage, storyImageWidths, storyImageAspectRatio, 95)}
              sizes="100vw"
              alt="Estela de Gracia"
              class="rounded-3xl shadow-xl w-full aspect-[3/4] object-cover"
              style={`object-position: ${hotspotToObjectPosition(story.storyImage)}`}
              loading="lazy"
              decoding="async"
            />
          </div>
        )}

        <div class={`grid ${story?.storyImage ? 'lg:grid-cols-[3fr_2fr]' : ''} gap-10`}>
          <div>
            {pullQuotes[0] && (
              <blockquote class="border-l-4 border-[#98465d] pl-6 mb-12">
                <p class="font-display text-2xl md:text-3xl text-[#98465d]/80 italic leading-relaxed">
                  {pullQuotes[0]}
                </p>
              </blockquote>
            )}

            {storyHtml ? (
              <div class="relative mb-12">
                <div
                  class="relative bg-white/90 rounded-3xl p-5 md:p-12 shadow-xl portable-text font-serif text-lg text-[#5d5a5a] leading-relaxed [&>p]:mb-6 [&>p:last-child]:mb-0"
                  set:html={storyHtml}
                />
              </div>
            ) : null}

            {pullQuotes[1] && (
              <blockquote class="border-l-4 border-[#9591eb] pl-6 mb-16">
                <p class="font-display text-xl md:text-2xl text-[#9591eb]/80 italic leading-relaxed">
                  {pullQuotes[1]}
                </p>
              </blockquote>
            )}
          </div>

          {story?.storyImage && (
            <div class="hidden lg:block sticky top-28 self-start">
              <img
                src={croppedImage(story.storyImage, 1600, storyImageAspectRatio, 95)}
                srcset={croppedSrcSet(story.storyImage, storyImageWidths, storyImageAspectRatio, 95)}
                sizes="40vw"
                alt="Estela de Gracia"
                class="rounded-3xl shadow-xl w-full aspect-[3/4] object-cover"
                style={`object-position: ${hotspotToObjectPosition(story.storyImage)}`}
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-12 mt-12">
          {personalTraits.map((trait) => {
            const svgPath = resolveIconSvg(trait.icon)
            return (
              <div class="group hover-relief bg-[#f6f3f5] rounded-3xl p-5 md:p-8 shadow-lg">
                <div class="w-14 h-14 bg-[#98465d]/10 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#98465d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={svgPath} />
                </div>
                <h3 class="font-semibold text-[#5d5a5a] text-lg mb-2">{trait.label}</h3>
                <p class="text-[#5d5a5a]/70">{trait.description}</p>
              </div>
            )
          })}
        </div>

        <div class="text-center">
          <p class="font-serif text-lg text-[#5d5a5a]/80 mb-4 italic">
            {story?.inlineCta?.text}
          </p>
          <a href={story?.inlineCta?.buttonHref ?? '/contacto'}>
            <button class="hover-shimmer inline-flex items-center justify-center bg-[#98465d] hover:bg-[#98465d]/90 text-white rounded-full px-8 py-4 text-lg font-medium transition-all hover:scale-105 hover:shadow-lg hover:shadow-[#98465d]/25">
              {story?.inlineCta?.buttonLabel}
            </button>
          </a>
        </div>
      </div>
    </section>
  </div>

  {page?.transitionBanner?.image && (
    <div class="section-flow" style="--section-bg: #f4eced; --next-bg: #efedf6">
      <TransitionImageBanner
        imageUrl={fullBleedHero(page.transitionBanner.image)}
        imageSrcSet={srcSet(page.transitionBanner.image)}
        imagePosition={hotspotToObjectPosition(page.transitionBanner.image)}
        title={page.transitionBanner.title}
        subtitle={page.transitionBanner.subtitle}
      />
    </div>
  )}

  <div class="section-flow" style="--section-bg: #efedf6; --next-bg: #f5eff1">
    <TrustBar stats={page?.trustBar} />
  </div>

  <div class="section-flow" style="--section-bg: #f5eff1; --next-bg: #f0eef5">
    <section class="py-14 md:py-20 lg:py-28 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-[#cfcdff]/20 rounded-full blur-3xl"></div>

      <div class="container mx-auto px-5 relative">
        <div class="text-center mb-10 md:mb-14">
          <span class="inline-block text-[#9591eb] font-medium mb-4 tracking-wide uppercase text-sm">
            {approach?.sectionLabel}
          </span>
          <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] mb-6 text-balance">
            {approach?.title}{' '}
            <span class="text-[#98465d]">{approach?.titleHighlight}</span>
          </h2>
          <p class="text-lg text-[#5d5a5a]/80 max-w-2xl mx-auto font-serif leading-relaxed">
            {approach?.philosophy}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {approachCards.map((card) => {
            const svgPath = resolveIconSvg(card.icon)
            return (
              <div class="hover-relief bg-[#f6f3f5] rounded-3xl p-5 md:p-8 shadow-lg">
                <div class="flex gap-5">
                  <div class="w-14 h-14 bg-gradient-to-br from-[#98465d]/10 to-[#9591eb]/10 rounded-2xl flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#98465d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={svgPath} />
                  </div>
                  <div>
                    <h3 class="font-display text-xl text-[#5d5a5a] mb-2">{card.title}</h3>
                    <p class="text-[#5d5a5a]/70 leading-relaxed">{card.description}</p>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f4eced">
    <TestimonialHighlight testimonials={page?.testimonials?.slice(0, 2)} />
  </div>

  <div class="section-flow" style="--section-bg: #f4eced; --next-bg: #f5eff2">
    <TimelineAnimated client:visible items={timelineItems} />
  </div>

  {page?.timelineImage && (
    <div class="section-flow" style="--section-bg: #f5eff2; --next-bg: #f6f3f5">
      <TransitionImageBanner
        imageUrl={fullBleedHero(page.timelineImage)}
        imageSrcSet={srcSet(page.timelineImage)}
        imagePosition={hotspotToObjectPosition(page.timelineImage)}
      />
    </div>
  )}

  <div class="section-flow" style="--section-bg: #f5eff2; --next-bg: #f6f3f5">
    <CTABanner
      title={cta.title}
      highlight={cta.highlight}
      description={cta.description}
      primaryCta={cta.primaryCta}
      secondaryCta={cta.secondaryCta}
        backgroundImageUrl={cta.backgroundImage ? portraitImage(cta.backgroundImage) : undefined}
        backgroundImageSrcSet={cta.backgroundImage ? portraitSrcSet(cta.backgroundImage) : undefined}
      backgroundImagePosition={hotspotToObjectPosition(cta.backgroundImage)}
    />
  </div>
</PageLayout>
