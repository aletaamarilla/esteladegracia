---
import PageLayout from '@/layouts/PageLayout.astro'
import PageHero from '@/sections/PageHero.astro'
import CTABanner from '@/sections/CTABanner.astro'
import TestimonialsLanding from '@/components/islands/TestimonialsLanding'
import { sanityFetch } from '@/lib/sanity'
import { testimonialsPageQuery, allTestimonialsQuery, siteSettingsQuery } from '@/lib/queries'
import type { TestimonialsPage, Testimonial, SiteSettings } from '@/lib/sanityTypes'
import { fullBleedHero, hotspotToObjectPosition, optimizeTestimonialPosters, portraitImage, portraitSrcSet, srcSet } from '@/lib/sanityImage'

const [page, allTestimonials, settings] = await Promise.all([
  sanityFetch<TestimonialsPage>(testimonialsPageQuery),
  sanityFetch<Testimonial[]>(allTestimonialsQuery),
  sanityFetch<SiteSettings>(siteSettingsQuery),
])

const whatsappUrl = settings?.contactInfo?.whatsappNumber
  ? `https://wa.me/${settings.contactInfo.whatsappNumber}?text=${encodeURIComponent(settings.contactInfo.whatsappDefaultMessage ?? 'Hola! Me gustaria agendar una cita.')}`
  : 'https://wa.me/34600000000'

const optimizedTestimonials = optimizeTestimonialPosters(allTestimonials)

const ctaRaw = page?.ctaBanner ?? {}
const cta = {
  title: ctaRaw.title,
  highlight: ctaRaw.highlight,
  description: ctaRaw.description,
  primaryCta: ctaRaw.primaryCta,
  secondaryCta: ctaRaw.secondaryCta,
  backgroundImage: ctaRaw.backgroundImage,
}
---

<PageLayout
  title="Testimonios"
  description="Historias reales de personas que también estuvieron donde tú estás ahora. Descubre cómo la terapia puede transformar tu vida."
>
  <PageHero
    label={page?.heroLabel}
    title={page?.heroTitle}
    highlight={page?.heroHighlight}
    highlightColor="rose"
    description={page?.heroDescription}
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Testimonios' },
    ]}
    backgroundImageUrl={page?.heroImage ? fullBleedHero(page.heroImage) : undefined}
    backgroundImageSrcSet={page?.heroImage ? srcSet(page.heroImage) : undefined}
    backgroundImagePosition={hotspotToObjectPosition(page?.heroImage)}
  />

  <div class="testimonials-bg">
    <TestimonialsLanding client:visible testimonials={optimizedTestimonials} />
  </div>

  <div class="section-flow" style="--section-bg: #f5eff2; --next-bg: #f6f3f5">
    <CTABanner
      title={cta.title}
      highlight={cta.highlight}
      description={cta.description}
      primaryCta={cta.primaryCta}
      secondaryCta={cta.secondaryCta}
      backgroundImageUrl={cta.backgroundImage ? portraitImage(cta.backgroundImage) : undefined}
      backgroundImageSrcSet={cta.backgroundImage ? portraitSrcSet(cta.backgroundImage) : undefined}
      backgroundImagePosition={hotspotToObjectPosition(cta.backgroundImage)}
    />
  </div>
</PageLayout>

<style>
  .testimonials-bg {
    background: linear-gradient(
      165deg,
      #f0eef5 0%,
      #efedf4 25%,
      #f2edf2 50%,
      #f4eef0 75%,
      #f5eff2 100%
    );
  }
</style>
