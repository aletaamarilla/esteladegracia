---
import PageLayout from '@/layouts/PageLayout.astro'
import PageHero from '@/sections/PageHero.astro'
import CTABanner from '@/sections/CTABanner.astro'
import BlogCard from '@/components/shared/BlogCard.astro'
import { sanityFetch } from '@/lib/sanity'
import { blogIndexPageQuery, allBlogPostsQuery } from '@/lib/queries'
import type { BlogIndexPage, BlogPostPreview } from '@/lib/sanityTypes'
import { fullBleedHero, hotspotToObjectPosition, portraitImage, portraitSrcSet, srcSet } from '@/lib/sanityImage'

const [page, posts] = await Promise.all([
  sanityFetch<BlogIndexPage>(blogIndexPageQuery),
  sanityFetch<BlogPostPreview[]>(allBlogPostsQuery),
])

const allPosts = posts ?? []
const featuredPost = allPosts.find((p) => p.featured)
const regularPosts = allPosts.filter((p) => p !== featuredPost)

const categories = page?.categories ?? []

const ctaRaw = page?.ctaBanner ?? {}
const cta = {
  title: ctaRaw.title,
  highlight: ctaRaw.highlight,
  description: ctaRaw.description,
  primaryCta: ctaRaw.primaryCta,
  secondaryCta: ctaRaw.secondaryCta,
  backgroundImage: ctaRaw.backgroundImage,
}

const emptyStateText = page?.emptyStateText

const formatDate = (dateStr: string) =>
  new Date(dateStr).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })
---

<PageLayout
  title="Blog"
  description="Articulos sobre ansiedad, autoestima, relaciones y herramientas de bienestar emocional."
>
  <PageHero
    label={page?.heroLabel}
    title={page?.heroTitle}
    highlight={page?.heroHighlight}
    highlightColor="rose"
    description={page?.heroDescription}
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Blog' },
    ]}
    backgroundImageUrl={page?.heroImage ? fullBleedHero(page.heroImage) : undefined}
    backgroundImageSrcSet={page?.heroImage ? srcSet(page.heroImage) : undefined}
    backgroundImagePosition={hotspotToObjectPosition(page?.heroImage)}
  />

  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f5eff2">
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-5">
        <div class="flex flex-wrap gap-2 mb-12 justify-center">
          {categories.map((cat) => (
            <button
              data-category={cat.key}
              class:list={[
                'blog-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200',
                cat.key === 'todos'
                  ? 'bg-[#98465d] text-white'
                  : 'bg-[#f6f3f5] text-[#5d5a5a] hover:bg-[#98465d]/10 hover:text-[#98465d]',
              ]}
            >
              {cat.label}
            </button>
          ))}
        </div>

        {featuredPost && (
          <div class="mb-12 blog-card" data-category={featuredPost.category}>
            <a href={`/blog/${featuredPost.slug.current}`} class="group block">
              <article class="bg-gradient-to-br from-[#f6f3f5] via-[#cfcdff]/10 to-white rounded-3xl p-5 md:p-12 shadow-sm hover:shadow-lg transition-all duration-300 relative overflow-hidden">
                <span class="absolute top-6 right-6 bg-[#98465d] text-white text-xs font-medium px-3 py-1 rounded-full">
                  Destacado
                </span>
                <div class="max-w-2xl">
                  {featuredPost.category && (
                    <span class="inline-block text-xs font-medium px-3 py-1 rounded-full bg-[#98465d]/10 text-[#98465d] mb-4">
                      {featuredPost.category}
                    </span>
                  )}
                  <h2 class="font-display text-2xl md:text-3xl text-[#5d5a5a] mb-4 group-hover:text-[#98465d] transition-colors">
                    {featuredPost.title}
                  </h2>
                  <p class="text-[#5d5a5a]/70 leading-relaxed mb-6">
                    {featuredPost.description}
                  </p>
                  <div class="flex items-center gap-4 text-sm text-[#5d5a5a]/50">
                    <time datetime={featuredPost.publishedDate}>
                      {formatDate(featuredPost.publishedDate)}
                    </time>
                    {featuredPost.readingTime && (
                      <span>{featuredPost.readingTime} min lectura</span>
                    )}
                  </div>
                </div>
              </article>
            </a>
          </div>
        )}

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
          {regularPosts.map((post) => (
            <div class="blog-card" data-category={post.category}>
              <BlogCard
                title={post.title}
                description={post.description}
                href={`/blog/${post.slug.current}`}
                date={post.publishedDate}
                category={post.category}
                readingTime={post.readingTime}
                coverImage={post.coverImage}
              />
            </div>
          ))}
        </div>

        <div id="blog-empty" class="hidden text-center py-16">
          <p class="text-[#5d5a5a]/50 text-lg">{emptyStateText}</p>
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f5eff2; --next-bg: #f6f3f5">
    <CTABanner
      title={cta.title}
      description={cta.description}
      primaryCta={cta.primaryCta}
      secondaryCta={cta.secondaryCta}
      backgroundImageUrl={cta.backgroundImage ? portraitImage(cta.backgroundImage) : undefined}
      backgroundImageSrcSet={cta.backgroundImage ? portraitSrcSet(cta.backgroundImage) : undefined}
      backgroundImagePosition={hotspotToObjectPosition(cta.backgroundImage)}
    />
  </div>
</PageLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.blog-filter');
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  const emptyState = document.getElementById('blog-empty');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category;

      filters.forEach((f) => {
        f.classList.remove('bg-[#98465d]', 'text-white');
        f.classList.add('bg-[#f6f3f5]', 'text-[#5d5a5a]');
      });
      btn.classList.remove('bg-[#f6f3f5]', 'text-[#5d5a5a]');
      btn.classList.add('bg-[#98465d]', 'text-white');

      let visibleCount = 0;
      cards.forEach((card) => {
        if (category === 'todos' || card.dataset.category === category) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    });
  });
</script>
