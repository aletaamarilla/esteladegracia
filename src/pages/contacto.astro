---
import PageLayout from '@/layouts/PageLayout.astro'
import ContactSection from '@/components/islands/ContactSection'
import { sanityFetch } from '@/lib/sanity'
import { contactPageQuery, siteSettingsQuery } from '@/lib/queries'
import type { ContactPage, SiteSettings } from '@/lib/sanityTypes'
import { resolveIconSvg } from '@/lib/icons'
import { hotspotToObjectPosition, portraitImage, portraitSrcSet } from '@/lib/sanityImage'

const [page, settings] = await Promise.all([
  sanityFetch<ContactPage>(contactPageQuery),
  sanityFetch<SiteSettings>(siteSettingsQuery),
])

const whatsappUrl = settings?.contactInfo?.whatsappNumber
  ? `https://wa.me/${settings.contactInfo.whatsappNumber}?text=${encodeURIComponent(settings.contactInfo.whatsappDefaultMessage ?? 'Hola! Me gustaria agendar una cita.')}`
  : 'https://wa.me/34600000000'

const whatsappPhone = settings?.contactInfo?.phone

const infoCards = page?.infoCards ?? []

const iconColors = ['#98465d', '#9591eb', '#5d5a5a']
const iconBgColors = ['bg-[#98465d]/10', 'bg-[#9591eb]/10', 'bg-[#cfcdff]/50']
const iconHoverBg = ['group-hover:bg-[#98465d]/20', 'group-hover:bg-[#9591eb]/20', 'group-hover:bg-[#cfcdff]/70']
---

<PageLayout
  title="Contacto"
  description="Reserva tu primera sesion o enviame un mensaje. Respondo en menos de 24 horas."
  showStickyMobileCTA={false}
>
  <div class="bg-gradient-to-br from-[#f6f3f5] via-[#cfcdff]/20 to-[#f6f3f5] pt-6 pb-2">
    <div class="container mx-auto px-5">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-[#5d5a5a]/60">
          <li><a href="/" class="hover:text-[#98465d] transition-colors">Inicio</a></li>
          <span class="text-[#cfcdff]">/</span>
          <li class="text-[#5d5a5a] font-medium">Contacto</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f4eced">
    <ContactSection
      client:visible
      sectionLabel={page?.sectionLabel}
      title={page?.title}
      titleHighlight={page?.titleHighlight}
      subtitle={page?.subtitle}
      formLabels={page?.formLabels}
      successState={page?.successState}
      whatsappSection={page?.whatsappSection}
      whatsappUrl={whatsappUrl}
      whatsappPhone={whatsappPhone}
      sideImageUrl={page?.sideImage ? portraitImage(page.sideImage) : undefined}
      sideImageSrcSet={page?.sideImage ? portraitSrcSet(page.sideImage) : undefined}
      sideImagePosition={hotspotToObjectPosition(page?.sideImage)}
    />
  </div>

  <div class="section-flow" style="--section-bg: #f4eced; --next-bg: #f6f3f5">
    <section class="py-16">
      <div class="container mx-auto px-5">
        <div class="grid md:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto text-center">
          {infoCards.map((card, i) => {
            const color = iconColors[i % iconColors.length]
            const bg = iconBgColors[i % iconBgColors.length]
            const hover = iconHoverBg[i % iconHoverBg.length]
            const svgPath = resolveIconSvg(card.icon)
            return (
              <div class="group bg-[#f6f3f5] rounded-3xl p-5 md:p-8 hover-glow cursor-default">
                <div class={`w-12 h-12 ${bg} rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 ${hover} transition-all duration-300`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={svgPath} />
                </div>
                <h3 class="font-semibold text-[#5d5a5a] mb-2">{card.title}</h3>
                <p class="text-sm text-[#5d5a5a]/70">{card.description}</p>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  </div>
</PageLayout>
