---
import PageLayout from '@/layouts/PageLayout.astro'
import PageHero from '@/sections/PageHero.astro'
import CTABanner from '@/sections/CTABanner.astro'
import EmailGate from '@/components/islands/EmailGate'
import { sanityFetch } from '@/lib/sanity'
import { resourcesPageQuery, allResourcesQuery, siteSettingsQuery } from '@/lib/queries'
import type { ResourcesPage, Resource, SiteSettings } from '@/lib/sanityTypes'
import { fullBleedHero, hotspotToObjectPosition, portraitImage, portraitSrcSet, srcSet } from '@/lib/sanityImage'

const [page, resources, settings] = await Promise.all([
  sanityFetch<ResourcesPage>(resourcesPageQuery),
  sanityFetch<Resource[]>(allResourcesQuery),
  sanityFetch<SiteSettings>(siteSettingsQuery),
])

const whatsappUrl = settings?.contactInfo?.whatsappNumber
  ? `https://wa.me/${settings.contactInfo.whatsappNumber}?text=${encodeURIComponent(settings.contactInfo.whatsappDefaultMessage ?? 'Hola! Me gustaria agendar una cita.')}`
  : 'https://wa.me/34600000000'

const ctaRaw = page?.ctaBanner ?? {}
const cta = {
  title: ctaRaw.title,
  highlight: ctaRaw.highlight,
  description: ctaRaw.description,
  primaryCta: ctaRaw.primaryCta,
  secondaryCta: ctaRaw.secondaryCta,
  backgroundImage: ctaRaw.backgroundImage,
}

const allResources = resources ?? []
const resourceData = allResources.map((r) => ({
  title: r.title,
  description: r.description ?? '',
  type: r.type,
  slug: r.slug.current,
  fileUrl: r.fileUrl,
}))

const typeIcons: Record<string, { emoji: string; color: string }> = {
  pdf: { emoji: '📄', color: 'from-[#98465d]/10 to-[#98465d]/5' },
  audio: { emoji: '🎧', color: 'from-[#9591eb]/10 to-[#9591eb]/5' },
  video: { emoji: '🎬', color: 'from-[#cfcdff]/30 to-[#cfcdff]/10' },
  checklist: { emoji: '✅', color: 'from-green-100 to-green-50' },
}

const valuePropositions = page?.valuePropositions ?? []

const emailGate = page?.emailGate ?? {}
const testimonialInline = page?.inlineTestimonial ?? {}
const blogCross = page?.blogCrossLink ?? {}
---

<PageLayout
  title="Recursos Gratuitos"
  description="Herramientas, guias y meditaciones gratuitas para tu bienestar emocional."
>
  <PageHero
    label={page?.heroLabel}
    title={page?.heroTitle}
    highlight={page?.heroHighlight}
    highlightColor="purple"
    description={page?.heroDescription}
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Recursos Gratuitos' },
    ]}
    backgroundImageUrl={page?.heroImage ? fullBleedHero(page.heroImage) : undefined}
    backgroundImageSrcSet={page?.heroImage ? srcSet(page.heroImage) : undefined}
    backgroundImagePosition={hotspotToObjectPosition(page?.heroImage)}
  />

  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f5eff1">
    <section class="py-12">
      <div class="container mx-auto px-5">
        <div class="flex flex-wrap justify-center gap-4 md:gap-14 text-center">
          {valuePropositions.map((item) => (
            <div class="flex items-center gap-2.5 group cursor-default">
              <span class="text-xl group-hover:scale-125 transition-transform duration-300">{item.icon}</span>
              <span class="text-sm text-[#5d5a5a]/70 font-medium group-hover:text-[#5d5a5a] transition-colors">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f5eff1; --next-bg: #efedf6">
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-5">
        <div class="text-center mb-14">
          <span class="inline-block text-[#9591eb] font-medium mb-4 tracking-wide uppercase text-sm">
            {page?.previewSection?.sectionLabel}
          </span>
          <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
            {page?.previewSection?.title}{' '}
            <span class="text-[#98465d]">{page?.previewSection?.titleHighlight}</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16">
          {allResources.map((recurso) => {
            const typeInfo = typeIcons[recurso.type] ?? typeIcons.pdf
            return (
              <div class="group relative bg-gradient-to-br from-[#f6f3f5] to-white rounded-3xl p-5 md:p-8 shadow-sm hover-glow cursor-default overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-[#cfcdff]/15 rounded-bl-full"></div>
                <div class="relative">
                  <div class="flex items-start gap-4 mb-4">
                    <span class="text-3xl group-hover:scale-125 transition-transform duration-300">{typeInfo.emoji}</span>
                    <div>
                      <span class="text-xs font-bold text-[#9591eb] uppercase tracking-wider">{recurso.type}</span>
                      <h3 class="font-display text-xl text-[#5d5a5a] mt-1">{recurso.title}</h3>
                    </div>
                  </div>
                  {recurso.description && (
                    <p class="text-sm text-[#5d5a5a]/70 leading-relaxed mb-4">{recurso.description}</p>
                  )}
                  <div class="flex items-center gap-2 text-xs text-[#98465d] font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Acceso inmediato al desbloquear
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #efedf6; --next-bg: #f4eced">
    <section class="py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute top-10 left-10 w-60 h-60 bg-[#98465d]/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-72 h-72 bg-[#9591eb]/10 rounded-full blur-3xl"></div>

      <div class="container mx-auto px-5 relative">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
            {emailGate.title}{' '}
            <span class="text-[#9591eb]">{emailGate.titleHighlight}</span>
          </h2>
          <p class="text-[#5d5a5a]/70 mt-4 max-w-lg mx-auto">
            {emailGate.description}
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <EmailGate client:load resources={resourceData} />
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f4eced; --next-bg: #f0eef5">
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-5">
        <div class="max-w-2xl mx-auto text-center">
          <div class="w-12 h-12 bg-[#cfcdff]/30 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#9591eb" stroke="none"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
          </div>
          <blockquote class="font-serif text-xl text-[#5d5a5a] leading-relaxed italic mb-6">
            &ldquo;{testimonialInline.quote}&rdquo;
          </blockquote>
          <p class="text-sm text-[#5d5a5a]/50 font-medium">
            — {testimonialInline.author}
          </p>
        </div>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f0eef5; --next-bg: #f5eff2">
    <section class="py-12">
      <div class="container mx-auto px-5 text-center">
        <p class="text-[#5d5a5a]/70 mb-4">{blogCross.text}</p>
        <a
          href={blogCross.linkHref ?? '/blog'}
          class="inline-flex items-center gap-2 text-[#98465d] font-medium hover:underline underline-offset-4 transition-all text-lg"
        >
          {blogCross.linkLabel}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </div>

  <div class="section-flow" style="--section-bg: #f5eff2; --next-bg: #f6f3f5">
    <CTABanner
      title={cta.title}
      highlight={cta.highlight}
      description={cta.description}
      primaryCta={cta.primaryCta}
      secondaryCta={cta.secondaryCta}
      backgroundImageUrl={cta.backgroundImage ? portraitImage(cta.backgroundImage) : undefined}
      backgroundImageSrcSet={cta.backgroundImage ? portraitSrcSet(cta.backgroundImage) : undefined}
      backgroundImagePosition={hotspotToObjectPosition(cta.backgroundImage)}
    />
  </div>
</PageLayout>
