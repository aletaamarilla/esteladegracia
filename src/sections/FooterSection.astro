---
import { normalizeGroupProgramNavLinks } from '@/lib/groupProgram'

interface NavLink {
  label: string
  href: string
  children?: Array<{ label: string; href: string }>
}

interface Props {
  brandName?: string
  tagline?: string
  logoSrc?: string
  logoAlt?: string
  footerSealSrc?: string
  footerSealAlt?: string
  footerContent?: {
    description?: string
    copyright?: string
    madeWithLoveText?: string
  }
  contactInfo?: {
    email?: string
    phone?: string
    whatsappNumber?: string
    whatsappDefaultMessage?: string
    responseTime?: string
    schedule?: string
  }
  socialLinks?: Array<{ platform: string; url: string }>
  whatsappUrl?: string
  navLinks?: NavLink[]
}

const defaultFooterLinks: NavLink[] = [
  { label: 'Sobre Mi', href: '/sobre-mi' },
  { label: 'Sesiones individuales', href: '/servicios/terapia-individual' },
  { label: 'Terapia grupal', href: '/servicios/terapia-grupal' },
  { label: 'Testimonios', href: '/testimonios' },
  { label: 'Blog', href: '/blog' },
  { label: 'Preguntas Frecuentes', href: '/faq' },
  { label: 'Recursos Gratuitos', href: '/recursos' },
]

const {
  brandName = 'Estela de Gracia',
  tagline = 'Psicologia Sin Distancia',
  logoSrc = '/logo-estela-de-gracia.png',
  logoAlt,
  footerSealSrc = '/sello-estela-de-gracia.png',
  footerSealAlt,
  footerContent,
  contactInfo,
  socialLinks,
  whatsappUrl = 'https://wa.me/34600000000?text=Hola!%20Me%20gustaria%20agendar%20una%20cita.',
  navLinks,
} = Astro.props

const footerLinks = normalizeGroupProgramNavLinks(navLinks
  ? navLinks.flatMap((link) => [
      { label: link.label, href: link.href },
      ...(link.children ?? []),
    ])
  : defaultFooterLinks)

const email = contactInfo?.email ?? 'hello@psychologist.com'
const description =
  footerContent?.description ??
  'Terapia autentica que se siente como hablar con alguien que realmente se preocupa. Porque mereces mas que distancia clinica.'
const copyright = footerContent?.copyright ?? `© ${new Date().getFullYear()} ${brandName} — ${tagline}. Todos los derechos reservados.`
const rawMadeWithLove = footerContent?.madeWithLoveText ?? 'para quienes buscan conexion'
const madeWithLoveAlreadyPrefixed = rawMadeWithLove.toLowerCase().startsWith('hecho con')
const madeWithLove = madeWithLoveAlreadyPrefixed
  ? rawMadeWithLove.replace(/^hecho con\s*❤️?\s*/i, '')
  : rawMadeWithLove
const instagramUrl = 'https://www.instagram.com/esteladegracia.psi/'
const visibleSocialLinks = socialLinks?.filter((social) => social.platform.toLowerCase() !== 'linkedin') ?? []

const socialIcons: Record<string, string> = {
  instagram: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  tiktok: '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>',
  youtube: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
}

const socialColors: Record<string, string> = {
  instagram: 'hover:bg-[#98465d] hover:shadow-[#98465d]/30',
  tiktok: 'hover:bg-[#5d5a5a] hover:shadow-[#5d5a5a]/30',
  youtube: 'hover:bg-red-600 hover:shadow-red-600/30',
}
---

<footer class="py-16 relative overflow-hidden bg-[#f6f3f5]">
  <div class="absolute top-0 right-0 w-64 h-64 bg-[#9591eb]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-[#98465d]/8 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-5 relative">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-10 md:mb-12">
      <div class="lg:col-span-2">
        <div class="flex flex-col items-center gap-5 text-center md:items-start md:text-left lg:flex-row lg:items-center lg:gap-7">
          <a href="/" class="inline-flex shrink-0 transition-transform duration-300 hover:scale-[1.02]" aria-label={brandName}>
            <img
              src={footerSealSrc}
              alt={footerSealAlt ?? `${brandName} - Psicologia Sanitaria`}
              class="h-auto w-36 max-w-full object-contain drop-shadow-[0_14px_30px_rgba(152,70,93,0.12)] sm:w-40 lg:w-36"
              width="402"
              height="419"
              loading="lazy"
            />
          </a>
          <div class="space-y-5">
            <p class="text-[#5d5a5a]/70 max-w-md leading-relaxed text-sm md:text-base">
              {description}
            </p>
            <div class="flex flex-col justify-center gap-3 sm:flex-row md:justify-start">
              <a href="/contacto?method=form" class="hover-shimmer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full text-sm font-medium bg-[#98465d] hover:bg-[#98465d]/90 text-white px-6 py-2.5 transition-all hover:scale-105 hover:shadow-lg hover:shadow-[#98465d]/30">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                Reserva cita
              </a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full text-sm font-medium bg-[#25D366] hover:bg-[#25D366]/90 text-white px-6 py-2.5 transition-all hover:scale-105 hover:shadow-lg hover:shadow-[#25D366]/30">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                Escribeme por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="hidden md:block space-y-4">
        <h4 class="font-semibold text-lg text-[#5d5a5a]">Enlaces Rapidos</h4>
        <ul class="space-y-3 text-[#5d5a5a]/60">
          {footerLinks.map((link) => (
            <li><a href={link.href} class="hover:text-[#98465d] transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <h4 class="font-semibold text-lg text-[#5d5a5a]">Contacto</h4>
        <ul class="space-y-3 text-[#5d5a5a]/60">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href={`mailto:${email}`} class="hover:text-[#98465d] transition-colors">
              {email}
            </a>
          </li>
          {visibleSocialLinks.length > 0 && (
            <li class="flex items-center gap-4 pt-2">
              {visibleSocialLinks.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`w-10 h-10 bg-[#5d5a5a]/10 rounded-full flex items-center justify-center hover:text-white hover:scale-110 hover:shadow-lg transition-all duration-300 text-[#5d5a5a] ${socialColors[social.platform] ?? 'hover:bg-[#98465d]'}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={socialIcons[social.platform] ?? ''} />
                </a>
              ))}
            </li>
          )}
          {visibleSocialLinks.length === 0 && (
            <li class="flex items-center gap-4 pt-2">
              <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-[#5d5a5a]/10 rounded-full flex items-center justify-center hover:bg-[#98465d] hover:text-white hover:scale-110 hover:shadow-lg hover:shadow-[#98465d]/30 transition-all duration-300 text-[#5d5a5a]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-[#5d5a5a]/10 flex flex-col md:flex-row justify-between items-center gap-4 text-[#5d5a5a]/40 text-sm">
      <p>{copyright}</p>
      <a href="/politica-de-privacidad" class="hover:text-[#98465d] transition-colors">
        Política de Privacidad
      </a>
      <p class="flex items-center gap-2">
        Hecho con
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#98465d" stroke="#98465d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        {madeWithLove}
      </p>
    </div>
  </div>
</footer>
