---
---

<footer class="py-16 relative overflow-hidden bg-[#f6f3f5]">
  <!-- Organic shape decoration -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-[#9591eb]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-[#98465d]/8 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-5 relative">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-10 md:mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2 space-y-5 md:space-y-6">
        <h3 class="font-display text-2xl text-[#5d5a5a]">Estela <span class="text-[#9591eb]">de Gracia</span></h3>
        <p class="text-[#5d5a5a]/40 text-sm -mt-4">Psicologia Sin Distancia</p>
        <p class="text-[#5d5a5a]/70 max-w-md leading-relaxed text-sm md:text-base">
          Terapia autentica que se siente como hablar con alguien que realmente se preocupa. Porque mereces mas que distancia clinica.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contacto?method=form" class="hover-shimmer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full text-sm font-medium bg-[#98465d] hover:bg-[#98465d]/90 text-white px-6 py-2.5 transition-all hover:scale-105 hover:shadow-lg hover:shadow-[#98465d]/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Reserva cita
          </a>
          <a href="https://wa.me/34600000000?text=Hola!%20Me%20gustaria%20agendar%20una%20cita." target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full text-sm font-medium bg-[#25D366] hover:bg-[#25D366]/90 text-white px-6 py-2.5 transition-all hover:scale-105 hover:shadow-lg hover:shadow-[#25D366]/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            Escribeme por WhatsApp
          </a>
        </div>
      </div>

      <!-- Quick Links (hidden on mobile — duplicates navigation) -->
      <div class="hidden md:block space-y-4">
        <h4 class="font-semibold text-lg text-[#5d5a5a]">Enlaces Rapidos</h4>
        <ul class="space-y-3 text-[#5d5a5a]/60">
          <li><a href="/sobre-mi" class="hover:text-[#98465d] transition-colors">Sobre Mi</a></li>
          <li><a href="/servicios/terapia-individual" class="hover:text-[#98465d] transition-colors">Terapia Individual</a></li>
          <li><a href="/servicios/terapia-grupal" class="hover:text-[#98465d] transition-colors">Terapia Grupal</a></li>
          <li><a href="/testimonios" class="hover:text-[#98465d] transition-colors">Testimonios</a></li>
          <li><a href="/blog" class="hover:text-[#98465d] transition-colors">Blog</a></li>
          <li><a href="/faq" class="hover:text-[#98465d] transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="/recursos" class="hover:text-[#98465d] transition-colors">Recursos Gratuitos</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="space-y-4">
        <h4 class="font-semibold text-lg text-[#5d5a5a]">Contacto</h4>
        <ul class="space-y-3 text-[#5d5a5a]/60">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:hello@psychologist.com" class="hover:text-[#98465d] transition-colors">
              hello@psychologist.com
            </a>
          </li>
          <li class="flex items-center gap-4 pt-2">
            <a href="#" class="w-10 h-10 bg-[#5d5a5a]/10 rounded-full flex items-center justify-center hover:bg-[#98465d] hover:text-white hover:scale-110 hover:shadow-lg hover:shadow-[#98465d]/30 transition-all duration-300 text-[#5d5a5a]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="#" class="w-10 h-10 bg-[#5d5a5a]/10 rounded-full flex items-center justify-center hover:bg-[#9591eb] hover:text-white hover:scale-110 hover:shadow-lg hover:shadow-[#9591eb]/30 transition-all duration-300 text-[#5d5a5a]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="pt-8 border-t border-[#5d5a5a]/10 flex flex-col md:flex-row justify-between items-center gap-4 text-[#5d5a5a]/40 text-sm">
      <p>&copy; 2026 Estela de Gracia — Psicologia Sin Distancia. Todos los derechos reservados.</p>
      <p class="flex items-center gap-2">
        Hecho con
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#98465d" stroke="#98465d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        para quienes buscan conexion
      </p>
    </div>
  </div>
</footer>
