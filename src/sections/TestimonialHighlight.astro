---
import { testimonials } from '../data/testimonials';

interface Props {
  count?: number
  title?: string
  linkText?: string
  linkHref?: string
}

const {
  count = 2,
  title = "Lo que dicen mis pacientes",
  linkText = "Ver todos los testimonios",
  linkHref = "/testimonios",
} = Astro.props;

const selectedTestimonials = testimonials.slice(0, count);
---

<section class="py-20 lg:py-28 bg-[#f6f3f5] relative overflow-hidden">
  <div class="absolute top-0 left-0 w-72 h-72 bg-[#9591eb]/10 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-4 relative">
    <div class="text-center mb-14">
      <span class="inline-block text-[#9591eb] font-medium mb-4 tracking-wide uppercase text-sm">Testimonios</span>
      <h2 class="font-display text-3xl md:text-4xl text-[#5d5a5a] text-balance">
        {title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {selectedTestimonials.map((testimonial) => (
        <div class="hover-relief bg-white rounded-3xl p-8 shadow-lg">
          {/* Stars */}
          <div class="flex gap-1 mb-4">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#facc15" stroke="#facc15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          {/* Quote */}
          <div class="relative mb-6">
            <svg class="absolute -top-2 -left-2 w-8 h-8 text-[#cfcdff]/60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <p class="font-serif text-[#5d5a5a] leading-relaxed pl-6 italic">
              "{testimonial.text}"
            </p>
          </div>

          {/* Author */}
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-[#5d5a5a]">{testimonial.name}</p>
              <p class="text-xs text-[#5d5a5a]/50">{testimonial.date}</p>
            </div>
            <span class="text-xs text-[#5d5a5a]/40 bg-[#f6f3f5] px-3 py-1 rounded-full">{testimonial.source}</span>
          </div>
        </div>
      ))}
    </div>

    {/* Link to full testimonials page */}
    <div class="text-center mt-10">
      <a
        href={linkHref}
        class="inline-flex items-center gap-2 text-[#98465d] font-medium hover:text-[#98465d]/80 transition-colors group"
      >
        {linkText}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
