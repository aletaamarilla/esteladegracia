---
import HeroVideoPlayer from '@/components/islands/HeroVideoPlayer';
---

<section class="relative min-h-[100svh] overflow-hidden bg-gradient-to-br from-[#f6f3f5] via-[#cfcdff]/20 to-[#f6f3f5] pt-20">
  <!-- Organic background shapes -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-20 -left-20 w-80 h-80 bg-[#cfcdff]/30 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute top-1/3 -right-20 w-96 h-96 bg-[#98465d]/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-72 h-72 bg-[#9591eb]/20 rounded-full blur-3xl"></div>
  </div>

  <div class="relative container mx-auto px-4 h-[calc(100svh-5rem)] flex flex-col">
    <HeroVideoPlayer client:load />
  </div>
</section>
