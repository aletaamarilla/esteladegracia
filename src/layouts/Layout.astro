---
import '@/styles/globals.css'
import SEOHead from '@/components/shared/SEOHead.astro'
import { sanityFetch } from '@/lib/sanity'
import { siteSettingsQuery } from '@/lib/queries'
import type { SiteSettings } from '@/lib/sanityTypes'
import { urlFor } from '@/lib/sanityImage'

interface Props {
  title?: string
  description?: string
  personImageUrl?: string
  heroImagePreload?: { url: string; srcset?: string }
}

const settings = await sanityFetch<SiteSettings>(siteSettingsQuery)

const {
  title = settings?.brandName
    ? `${settings.brandName} | ${settings.tagline ?? 'Psicología sin distancia'}`
    : 'Estela de Gracia | Psicología sin distancia',
  description,
  personImageUrl,
  heroImagePreload,
} = Astro.props

const cmsFaviconUrl = settings?.favicon ? urlFor(settings.favicon).width(64).height(64).fit('crop').url() : undefined
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEOHead title={title} description={description} />

    <!-- Favicons -->
    <link rel="icon" href={cmsFaviconUrl ?? '/favicon.ico?v=4'} sizes="any" />
    {!cmsFaviconUrl && <link rel="icon" href="/favicon-estela.png?v=4" type="image/png" sizes="512x512" />}
    {!cmsFaviconUrl && <link rel="icon" href="/favicon-32x32.png?v=4" type="image/png" sizes="32x32" />}
    {!cmsFaviconUrl && <link rel="icon" href="/favicon-16x16.png?v=4" type="image/png" sizes="16x16" />}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />

    <!-- Hero image preload -->
    {heroImagePreload && (
      <link
        rel="preload"
        as="image"
        href={heroImagePreload.url}
        imagesrcset={heroImagePreload.srcset}
        imagesizes="(max-width: 639px) 100vw, 55vw"
        fetchpriority="high"
      />
    )}

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": settings?.brandName ?? "Estela de Gracia",
      "url": Astro.site?.toString() ?? "https://psicologiasindistancia.com",
      "description": settings?.tagline ?? "Psicología sin distancia",
    })} />

    <!-- JSON-LD Person (Estela de Gracia) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": settings?.brandName ?? "Estela de Gracia",
      "jobTitle": "Psicóloga",
      "url": Astro.site?.toString() ?? "https://psicologiasindistancia.com",
      ...(personImageUrl ? { "image": personImageUrl } : {}),
      ...(settings?.contactInfo?.email ? { "email": settings.contactInfo.email } : {}),
    })} />
  </head>
  <body class="font-sans antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
